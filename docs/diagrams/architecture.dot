digraph A423 {
 graph [rankdir=TB, bgcolor="white", pad="0.38", nodesep="0.38", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=24, fontcolor="#0f172a", labelloc=t, labeljust=c];
 node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#94a3b8", fontcolor="#0f172a", fontname="DejaVu Sans", fontsize=14, margin="0.18,0.12", penwidth=1.3];
 edge [color="#64748b", fontcolor="#475569", fontname="DejaVu Sans", fontsize=11, penwidth=1.2, arrowsize=0.75];

 graph [label="A423 architecture\nYour application, the SDK and on-chain custody"];
 Caller [label="UI / humans / agents", fillcolor="#dbeafe", color="#2563eb"];
 subgraph cluster_backend {
  label="YOUR BACKEND"; fontsize=15; color="#cbd5e1"; style="rounded,filled"; fillcolor="#f8fafc"; margin=22;
  API [label="Authenticated API\nand chat tools", fillcolor="#dbeafe", color="#2563eb"];
  Authority [label="Authority\nAgent credentials", fillcolor="#ede9fe", color="#7c3aed"];
  Workflow [label="A423 workflow\nTerms, roles and states", fillcolor="#dbeafe", color="#2563eb"];
  Policy [label="Optional profit policy\nPrivate costs and limits", fillcolor="#ede9fe", color="#7c3aed"];
  Storage [label="Durable storage\nJobs / journal / queue / KV", fillcolor="#ede9fe", color="#7c3aed"];
  Adapter [label="Escrow adapters\nFresh chain checks", fillcolor="#dbeafe", color="#2563eb"];
  Signer [label="Your signers\nSpending approvals"];
  Runner [label="Your work runner\nDurable dispatch"];
  Artifact [label="Artifact\nResult hash"];
  Receipt [label="Fresh receipts\nPrivate projections", fillcolor="#dcfce7", color="#16a34a"];
  {rank=same; API; Authority;}
  {rank=same; Workflow; Policy; Storage;}
  Authority -> API [label="Authenticate", constraint=false];
  API -> Workflow;
  Policy -> Workflow [label="Policy checks", constraint=false];
  Workflow -> Storage [dir=both, constraint=false];
  Workflow -> Adapter;
  Workflow -> Runner [label="Execute after funding"];
  Runner -> Artifact;
  Artifact -> Workflow [label="Commitment", constraint=false];
  Adapter -> Signer;
  Workflow -> Receipt [style=dashed, label="Read records"];
 }
 RPC [label="RPC provider\nTestnet or mainnet", fillcolor="#fef3c7", color="#d97706"];
 Contract [label="A423Escrow contract\nHOLDS LOCKED TOKENS", fillcolor="#fef3c7", color="#d97706", penwidth=2];
 Wallets [label="Worker payout\nPayer refund", fillcolor="#dcfce7", color="#16a34a"];
 Caller -> API;
 Signer -> RPC [label="Sign / broadcast"];
 RPC -> Contract;
 Contract -> Wallets [label="Settle"];
 RPC -> Receipt [label="Revalidate", constraint=false];
 Receipt -> Caller [label="Read status", constraint=false];
}
