{
  "name": "@allorc/a423-sdk",
  "version": "0.8.1",
  "description": "Experimental backend SDK for agent job agreements, durable workflows, ERC-20 escrow, negotiated settlement and configurable profit policies",
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs"
    },
    "./workflow": {
      "types": "./src/workflow.d.ts",
      "import": "./src/workflow.mjs",
      "require": "./src/workflow.cjs"
    },
    "./escrow": {
      "import": {
        "types": "./src/escrow/index.d.mts",
        "default": "./src/escrow/index.mjs"
      },
      "require": {
        "types": "./src/escrow/index.d.ts",
        "default": "./src/escrow/index.cjs"
      }
    },
    "./storage": {
      "types": "./src/storage/index.d.ts",
      "import": "./src/storage/index.mjs",
      "require": "./src/storage/index.cjs"
    },
    "./authority": {
      "types": "./src/authority/index.d.ts",
      "import": "./src/authority/index.mjs",
      "require": "./src/authority/index.cjs"
    },
    "./operations": {
      "types": "./src/operations/index.d.ts",
      "import": "./src/operations/index.mjs",
      "require": "./src/operations/index.cjs"
    },
    "./policy": {
      "types": "./src/policy/index.d.ts",
      "import": "./src/policy/index.mjs",
      "require": "./src/policy/index.cjs"
    }
  },
  "files": [
    "src/index.cjs",
    "src/index.mjs",
    "src/index.d.ts",
    "examples/client.mjs",
    "examples/nextjs/lib/a423.ts",
    "examples/nextjs/app/api/a423/*/route.ts",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "src/workflow.cjs",
    "src/workflow.mjs",
    "src/workflow.d.ts",
    "INTEGRATION.md",
    "CHANGELOG.md",
    "src/escrow",
    "contracts/A423Escrow.sol",
    "ESCROW.md",
    "NOTICE",
    "src/storage",
    "src/authority",
    "src/operations",
    "OPERATIONS.md",
    "examples/operations-server.mjs",
    "scripts/deploy-escrow.mjs",
    "contracts/standard-input.json",
    "examples/operations-dashboard.html",
    "LEGACY.md",
    "scripts/operations-worker.mjs",
    "src/closing.cjs",
    "SETTLEMENT.md",
    "src/cancellation.cjs",
    "CANCELLATION.md",
    "src/policy",
    "PROFIT-POLICY.md",
    "examples/quickstart.mjs",
    "examples/README.md",
    "docs/diagrams"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "npm run typecheck && npm test",
    "build:escrow": "node scripts/compile-escrow.cjs",
    "typecheck": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 --lib es2022,dom test/workflow-types.mts test/escrow-types.mts test/escrow-types.cts test/operations-types.mts",
    "pretest": "npm run build:escrow"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nextjs",
    "agent",
    "a423",
    "sdk",
    "experimental"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allorc-official/A423-SDK.git"
  },
  "homepage": "https://github.com/Allorc-official/A423-SDK#readme",
  "bugs": {
    "url": "https://github.com/Allorc-official/A423-SDK/issues"
  },
  "peerDependencies": {
    "ethers": "^6.15.0",
    "pdf-lib": "^1.17.1"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "6.15.0",
    "ganache": "7.9.2",
    "pdf-lib": "1.17.1",
    "solc": "0.8.30",
    "typescript": "5.9.3"
  }
}
